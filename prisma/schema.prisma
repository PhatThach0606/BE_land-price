generator client {
  provider     = "prisma-client"
  output       = "../src/modules-system/prisma/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model timduong {
  gid  Int                      @id @default(autoincrement())
  id   Float?
  geom Unsupported("geometry")?

  @@index([geom], type: Gist)
}

model users {
  user_id    Int       @id @default(autoincrement())
  full_name  String?   @db.VarChar(255)
  email      String?   @unique @db.VarChar(255)
  phone      String?   @db.VarChar(20)
  password   String    @db.VarChar(255)
  role       String?   @default("user") @db.VarChar(50)
  deleted_by Int?      @default(0)
  deleted_at DateTime? @db.Timestamp(6)
  is_deleted Boolean?  @default(false)
  avatar     String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  gender     Boolean?
}

model giaothong_logic {
  gid        Int                      @id @default(autoincrement())
  ma_xa      String?                  @db.VarChar(5)
  id         String?                  @db.VarChar(6)
  ten_duong  String?                  @db.VarChar(254)
  loai_dat   String?                  @db.VarChar(10)
  vi_tri     Int?                     @db.SmallInt
  geom       Unsupported("geometry")?
  banggiadat banggiadat?              @relation(fields: [id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_giaothonglogic_banggiadat")

  @@index([geom], type: Gist)
}

model giaothong_render {
  gid       Int                      @id @default(autoincrement())
  ma_xa     String?                  @db.VarChar(5)
  id        String?                  @db.VarChar(6)
  ten_duong String?                  @db.VarChar(254)
  loai_dat  String?                  @db.VarChar(10)
  vi_tri    Int?                     @db.SmallInt
  geom      Unsupported("geometry")?

  @@index([geom], type: Gist)
}

model thuadat {
  gid       Int                      @id @default(autoincrement())
  ma_xa     String?                  @db.VarChar(5)
  mathuadat String?                  @db.VarChar(12)
  so_to     Float?
  so_thua   Float?
  dien_tich Float?
  loai_dat  String?                  @db.VarChar(10)
  geom      Unsupported("geometry")?

  @@index([geom], type: Gist)
}

model banggiadat {
  id              String            @id @db.VarChar(10)
  ten_duong       String?           @db.VarChar(255)
  doan_duong      String?           @db.VarChar(255)
  odt             Float?
  tmd             Float?
  skc             Float?
  giaothong_logic giaothong_logic[]
}
