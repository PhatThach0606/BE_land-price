generator client {
  provider     = "prisma-client-js"
  output       = "../src/modules-system/prisma/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model spatial_ref_sys {
  srid      Int     @id
  auth_name String? @db.VarChar(256)
  auth_srid Int?
  srtext    String? @db.VarChar(2048)
  proj4text String? @db.VarChar(2048)
}

model giaothong {
  gid       Int                      @id @default(autoincrement())
  ma_xa     String?                  @db.VarChar(5)
  dien_tich Float?
  ten_duong String?                  @db.VarChar(254)
  id_gt     Float?
  geom      Unsupported("geometry")?

  @@index([geom], type: Gist)
}

model timduong {
  gid       Int                      @id @default(autoincrement())
  ma_xa     String?                  @db.VarChar(5)
  dien_tich Float?
  ten_duong String?                  @db.VarChar(254)
  id_gt     Float?
  geom      Unsupported("geometry")?

  @@index([geom], type: Gist)
}

model benthanh {
  gid       Int                      @id @default(autoincrement())
  ma_xa     String?                  @db.VarChar(5)
  so_to     Float?
  so_thua   Float?
  dien_tich Float?
  loai_dat  String?                  @db.VarChar(3)
  mathuadat String?                  @db.VarChar(12)
  geom      Unsupported("geometry")?

  @@index([geom], type: Gist)
}

model users {
  user_id    Int       @id @default(autoincrement())
  full_name  String?   @db.VarChar(255)
  email      String?   @unique @db.VarChar(255)
  phone      String?   @db.VarChar(20)
  password   String    @db.VarChar(255)
  role       String?   @default("user") @db.VarChar(50)
  deleted_by Int?      @default(0)
  deleted_at DateTime? @db.Timestamp(6)
  is_deleted Boolean?  @default(false)
  avatar     String?   @db.VarChar(255)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
}

enum Role {
  ADMIN
  STAFF
  USER
}
